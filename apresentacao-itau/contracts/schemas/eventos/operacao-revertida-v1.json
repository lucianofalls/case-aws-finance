{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.itau.com.br/financas/limites/operacao-revertida/v1.json",
  "title": "operacao-revertida-v1",
  "description": "Operação órfã revertida pelo reconciliador. EventBridge 'financas'.",
  "type": "object",
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "correlationid",
    "data"
  ],
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "description": "único; chave de deduplicação (at-least-once)"
    },
    "source": {
      "type": "string"
    },
    "type": {
      "const": "br.com.itau.financas.limites.operacao-revertida.v1"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "type": "string"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "dataschema": {
      "type": "string",
      "format": "uri"
    },
    "traceparent": {
      "type": "string",
      "description": "W3C Trace Context"
    },
    "correlationid": {
      "type": "string",
      "description": "rastreio ponta a ponta (PDF §2.4, não nulo); sem correlação recebida = id do evento"
    },
    "partitionkey": {
      "type": "string",
      "description": "id_contrato (ordenação por contrato)"
    },
    "data": {
      "type": "object",
      "required": [
        "id_contrato",
        "id_operacao",
        "tipo_operacao",
        "valor",
        "moeda",
        "limite_disponivel"
      ],
      "properties": {
        "id_contrato": {
          "type": "string"
        },
        "id_operacao": {
          "type": "string",
          "format": "uuid"
        },
        "tipo_operacao": {
          "type": "string"
        },
        "valor": {
          "type": "string",
          "pattern": "^-?\\d{1,16}\\.\\d{2}$",
          "description": "decimal(18,2) como string"
        },
        "moeda": {
          "type": "string"
        },
        "limite_disponivel": {
          "type": "string",
          "pattern": "^-?\\d{1,16}\\.\\d{2}$",
          "description": "decimal(18,2) como string"
        }
      },
      "additionalProperties": true
    }
  }
}
