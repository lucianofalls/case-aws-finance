{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.itau.com.br/financas/corebanking/limite-concedido/v1.json",
  "title": "limite-concedido-v1",
  "description": "Limite do contrato vindo do core banking pela ACL. EventBridge 'financas'.",
  "type": "object",
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "correlationid",
    "data"
  ],
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "description": "único; chave de deduplicação (at-least-once)"
    },
    "source": {
      "type": "string"
    },
    "type": {
      "const": "br.com.itau.financas.corebanking.limite-concedido.v1"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "type": "string"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "dataschema": {
      "type": "string",
      "format": "uri"
    },
    "traceparent": {
      "type": "string",
      "description": "W3C Trace Context"
    },
    "correlationid": {
      "type": "string",
      "description": "rastreio ponta a ponta (PDF §2.4, não nulo); sem correlação recebida = id do evento"
    },
    "partitionkey": {
      "type": "string",
      "description": "id_contrato (ordenação por contrato)"
    },
    "data": {
      "type": "object",
      "required": [
        "id_contrato",
        "id_conta",
        "produto",
        "limite_concedido",
        "moeda",
        "versao_origem"
      ],
      "properties": {
        "id_contrato": {
          "type": "string"
        },
        "id_conta": {
          "type": "string"
        },
        "produto": {
          "enum": [
            "CREDITO_PESSOAL",
            "CARTAO_DE_CREDITO",
            "CHEQUE_ESPECIAL",
            "INVESTIMENTO",
            "SEGURO",
            "CONSORCIO"
          ]
        },
        "limite_concedido": {
          "type": "string",
          "pattern": "^-?\\d{1,16}\\.\\d{2}$",
          "description": "decimal(18,2) como string"
        },
        "moeda": {
          "type": "string"
        },
        "versao_origem": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    }
  }
}
