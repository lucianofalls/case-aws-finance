# Copie para terraform.tfvars e ajuste.
versao_imagem          = "1.0.0-abc1234"
diretorio_artefatos    = "../../../../artefatos"
modo_cobranca_dynamodb = "PAY_PER_REQUEST" # go-live; migrar para PROVISIONED após 2–4 semanas de baseline
shards_transacoes      = 8

# OBRIGATORIO — credencial de leitura/exportacao, criada pelo DBA e distinta do RDS master.
# Jamais comite a senha; coloque somente o ARN do Secrets Manager no tfvars privado.
segredo_exportacao_rds_arn = "arn:aws:secretsmanager:sa-east-1:111122223333:secret:financas/contabilizacao-export-EXEMPLO"
